# =============================================================================
# Neural Noise / FinPilot AI - Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file with secrets to Git or GitHub.
# =============================================================================

# PostgreSQL Database (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finpilot

# Optional LLM API Keys (Deterministic hybrid fallback operates automatically without API keys)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Workspace Defaults (India)
BUSINESS_NAME=Apex Global Technologies Pvt Ltd
BUSINESS_STATE_CODE=29
DEFAULT_CURRENCY=INR

# Feature Flags
DISABLE_CHRONOS=1
LITELLM_LOG=ERROR
